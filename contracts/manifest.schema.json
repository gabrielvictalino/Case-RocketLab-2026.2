              "properties": {
                "duracao_min": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                "duracao_efetiva_min": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              }
            }
          }
        },
        "receita_volume_mensal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "rows",
            "sha256",
            "totals"
          ],
          "properties": {
            "file": {
              "const": "receita_volume_mensal.csv"
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "totals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "volume_faturado_kwh",
                "receita",
                "receita_arrecadada"
              ],
              "properties": {
                "volume_faturado_kwh": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                "receita": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                "receita_arrecadada": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              }
            }
          }
        },
        "uc_consumo_faturamento_mensal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
