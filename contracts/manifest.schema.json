            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "totals": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        "ocorrencias_uc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "rows",
            "sha256",
            "totals"
          ],
          "properties": {
            "file": {
              "const": "ocorrencias_uc.csv"
            },
            "rows": {
