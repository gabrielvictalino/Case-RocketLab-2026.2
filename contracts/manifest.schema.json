            },
            "totals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "volume_faturado_kwh",
                "valor_total",
                "valor_arrecadado"
              ],
              "properties": {
                "volume_faturado_kwh": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                "valor_total": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                "valor_arrecadado": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              }
            }
          }
