# Exclusivamente desenvolvimento local. Copie para .env, que não é versionado.
APP_ENV=development
POSTGRES_DB=venergy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
PORTAL_ROLE_PASSWORD=portal_dev
AI_READ_ROLE_PASSWORD=ai_dev
IMPORTADOR_ROLE_PASSWORD=importador_dev
DATABASE_URL_PORTAL=postgresql+asyncpg://portal:portal_dev@localhost:5432/venergy
DATABASE_URL_AI=postgresql+asyncpg://ai_read:ai_dev@localhost:5432/venergy
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres:postgres_dev@localhost:5432/venergy
DATABASE_URL_IMPORTADOR=postgresql://importador:importador_dev@localhost:5432/venergy
REDIS_URL=redis://localhost:6379/0
# Diretório de exportação montado em /entrada no serviço importador.
GOLD_EXPORT_DIR=./contracts/samples
JWT_SECRET=desenvolvimento-local-troque-esta-chave-32
JWT_EXPIRATION_HOURS=8
# Porta publicada pelo Nginx no host (padrão: 80).
# PORTAL_PORT=80
# Agente. Sem a chave do provedor escolhido, POST /api/v1/assistente/perguntas responde 503.
# Com AI_PROVEDOR=openrouter, AI_MODELO usa o nome do OpenRouter (ex.: google/gemini-3.1-flash-lite).
AI_PROVEDOR=google
AI_MODELO=gemini-3.1-flash-lite
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Limites por usuário no Redis: perguntas ao assistente por minuto, tokens do LLM por dia
# e insights gerados pelo modelo por minuto (um insight do cache não conta).
ASSISTENTE_PERGUNTAS_POR_MINUTO=20
ASSISTENTE_COTA_TOKENS_DIA=500000
INSIGHTS_POR_MINUTO=30
