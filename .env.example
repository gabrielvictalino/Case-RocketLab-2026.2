# Exclusivamente desenvolvimento local. Copie para .env, que não é versionado.
APP_ENV=development
POSTGRES_DB=venergy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
PORTAL_ROLE_PASSWORD=portal_dev
AI_READ_ROLE_PASSWORD=ai_dev
IMPORTADOR_ROLE_PASSWORD=importador_dev
DATABASE_URL_PORTAL=postgresql+asyncpg://portal:portal_dev@localhost:5432/venergy
DATABASE_URL_AI=postgresql+asyncpg://ai_read:ai_dev@localhost:5432/venergy
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres:postgres_dev@localhost:5432/venergy
DATABASE_URL_IMPORTADOR=postgresql://importador:importador_dev@localhost:5432/venergy
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=desenvolvimento-local-troque-esta-chave-32
